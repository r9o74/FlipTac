def merge_sort(arr):
    if len(arr) <= 1:
        return arr

    # 1.分割
    mid = len(arr) // 2
    left_half = arr[:mid]
    right_half = arr[mid:]


    # 2.統治（左右の部分リストを再帰的にソート）
    left_sorted = merge_sort(left_half)
    right_sorted = merge_sort(right_half)

    # 3.結合
    return merge(left_sorted, right_sorted)


def merge(left, right):
    merged_list = []
    i, j = 0, 0


    # 左右のリストを比較し、小さい方を結果リストに追加。
    while len(left) > 0 and len(right) > 0:
        if left[0] < right[0]:
            merged_list.append(left[0])
            left.pop(0)
        else:
            merged_list.append(right[0])
            right.pop(0)
            
        
    # どちらかのリストが空になったら残り要素をすべて追加する。
    merged_list.extend(left)
    merged_list.extend(right)

    return merged_list


import random

if __name__ == "__main__":
    data = [round(random.random() * 100) for _ in range(10)]
    print(data)
    print(merge_sort(data))
